// src/App.js
import React, { useState } from 'react';
import { Shield, Lock, Eye, AlertTriangle, Users, ChevronRight } from 'lucide-react';
import './App.css';

export default function App() {
  const [page, setPage] = useState('home');
  const [quizAnswers, setQuizAnswers] = useState({});
  const [quizSubmitted, setQuizSubmitted] = useState(false);
  const [quizScore, setQuizScore] = useState(0);

  const threats = [
    { icon: AlertTriangle, title: 'Cyberbullying', desc: 'Harassment through digital platforms.', color: 'from-red-500 to-orange-500' },
    { icon: Eye, title: 'Privacy Risks', desc: 'Personal data exposure online.', color: 'from-purple-500 to-pink-500' },
    { icon: Lock, title: 'Hacking', desc: 'Unauthorized access to accounts.', color: 'from-blue-500 to-cyan-500' },
    { icon: Users, title: 'Social Engineering', desc: 'Manipulation techniques to reveal info.', color: 'from-green-500 to-teal-500' },
    { icon: Shield, title: 'Phishing', desc: 'Fake messages designed to steal data.', color: 'from-yellow-500 to-orange-500' },
  ];

  const tips = [
    'Use strong passwords', 'Enable 2FA', 'Think before clicking links', 
    'Keep info private', 'Verify who you talk to', 'Report suspicious activity',
    'Update apps/devices', 'Use privacy settings', 'Never share passwords',
    'Be careful what you post', 'Avoid public Wi-Fi', 'Ignore strangers requests',
    'Use VPN', 'Back up data', 'Be skeptical of messages', 'Log out on shared devices'
  ];

  const quiz = [
    { q: "Cyberbullying?", options: ["Friendly messages", "Harassment", "Gaming", "Create accounts"], correct:1 },
    { q: "Suspicious email?", options:["Reply","Click links","Delete/report","Forward"], correct:2 },
    { q: "Phishing?", options:["Sport","Fake messages","App","Game"], correct:1 },
    { q: "Friend requests from strangers?", options:["Yes","No","If nice","Only Fridays"], correct:1 },
    { q: "VPN stands for?", options:["Very Private","Virtual Private","Video Playing","Verified Personal"], correct:1 }
  ];

  const handleQuizAnswer = (i, j) => setQuizAnswers({...quizAnswers, [i]: j});
  const submitQuiz = () => {
    let score = 0;
    quiz.forEach((q,i)=>{ if(quizAnswers[i]===q.correct) score++; });
    setQuizScore(score); setQuizSubmitted(true);
    window.scrollTo({top:0, behavior:'smooth'});
  };
  const resetQuiz = ()=>{ setQuizAnswers({}); setQuizSubmitted(false); setQuizScore(0); }

  const Home = () => (
    <div className="min-h-screen flex flex-col items-center justify-center text-center px-4">
      <h1 className="text-5xl font-bold text-blue-400 mb-6">Cyber Safety for Teens</h1>
      <div className="flex gap-4 flex-wrap justify-center">
        <button onClick={()=>setPage('threats')} className="px-6 py-3 bg-blue-600 rounded-lg text-white flex items-center gap-2">Explore Threats <ChevronRight /></button>
        <button onClick={()=>setPage('tips')} className="px-6 py-3 bg-slate-800 rounded-lg text-white">Safety Tips</button>
        <button onClick={()=>setPage('quiz')} className="px-6 py-3 bg-green-600 rounded-lg text-white">Quiz</button>
      </div>
    </div>
  );

  const ThreatsPage = () => (
    <div className="min-h-screen p-6">
      <h2 className="text-4xl font-bold text-blue-400 mb-6">Threats</h2>
      <div className="grid md:grid-cols-2 gap-4">
        {threats.map((t,i)=>(
          <div key={i} className="p-4 border rounded-lg bg-slate-800 text-white">
            <t.icon className="w-6 h-6 mb-2"/>
            <h3 className="font-bold">{t.title}</h3>
            <p>{t.desc}</p>
          </div>
        ))}
      </div>
    </div>
  );

  const TipsPage = () => (
    <div className="min-h-screen p-6">
      <h2 className="text-4xl font-bold text-blue-400 mb-6">Safety Tips</h2>
      <ul className="list-decimal pl-6 text-white">
        {tips.map((tip,i)=><li key={i} className="mb-2">{tip}</li>)}
      </ul>
    </div>
  );

  const QuizPage = () => (
    <div className="min-h-screen p-6">
      <h2 className="text-4xl font-bold text-blue-400 mb-6">Quiz</h2>
      {quizSubmitted ? (
        <div>
          <h3 className="text-2xl mb-4">Score: {quizScore}/{quiz.length}</h3>
          <button onClick={resetQuiz} className="px-6 py-2 bg-blue-600 rounded-lg text-white">Retake</button>
        </div>
      ) : (
        <div className="space-y-4">
          {quiz.map((q,i)=>(
            <div key={i} className="p-4 border rounded-lg bg-slate-800 text-white">
              <p className="font-bold">{q.q}</p>
              <div className="flex flex-col mt-2">
                {q.options.map((o,j)=>(
                  <button key={j} onClick={()=>handleQuizAnswer(i,j)} className={`p-2 mt-1 border rounded ${quizAnswers[i]===j?'bg-blue-600 text-white':'bg-slate-700'}`}>{o}</button>
                ))}
              </div>
            </div>
          ))}
          <button onClick={submitQuiz} className="px-6 py-3 mt-4 bg-green-600 rounded-lg text-white">Submit Quiz</button>
        </div>
      )}
    </div>
  );

  return (
    <div className="bg-slate-900 min-h-screen text-white">
      {page==='home' && <Home />}
      {page==='threats' && <ThreatsPage />}
      {page==='tips' && <TipsPage />}
      {page==='quiz' && <QuizPage />}
    </div>
  );
}

